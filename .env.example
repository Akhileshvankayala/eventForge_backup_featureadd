# Copy to .env (gitignored — never commit real keys).
# Enables the generative copilot layer (grounded answers via OpenRouter).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional override, defaults to nex-agi/nex-n2.5-mini:free
# OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=eventForge
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Frontend build-time API endpoint when deploying the Vercel frontend.
# VITE_API_URL=https://your-render-service.onrender.com
